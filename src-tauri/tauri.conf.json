{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QA Automation Suite",
  "version": "1.1.1",
  "identifier": "com.diego-bautista.tauri-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QA Automation Suite",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": ["../CHANGELOG.md"],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://your-server.com/releases/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFNzI4RTA3ODkwQTE0OEYKUldTUEZBcUpCNDV5N3Z4RnNJRjJ2L2JvOHBqbEhwNllDZnIveGVYY05EMEJ1eC9SL2Y3SG5peSsK"
    }
  }
}
