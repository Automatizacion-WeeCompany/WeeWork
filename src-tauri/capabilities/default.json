{
  "$schema": "../gen/schemas/desktop-capability.json",
  "identifier": "main-capability",
  "description": "Capacidades para WeeBot (Windows/macOS)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-message",
    "shell:allow-execute",
    "shell:default",
    "updater:default",
    "process:allow-restart",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-resource-read",
    "fs:allow-resource-write"
  ]
}